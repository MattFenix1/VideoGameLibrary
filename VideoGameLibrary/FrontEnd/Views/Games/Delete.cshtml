@model VideoGameLibrary.FrontEnd.Models.Game
@{
    ViewData["Title"] = "Delete Game";
}
<div class="container">
    <h1>Delete Game</h1>
    <h3>Are you sure you want to delete this game?</h3>
    <div class="mb-3">
        <strong>Title:</strong>
        @Model.Title
    </div>
    <div class="mb-3">
        <strong>Developer:</strong>
        @Model.Developer
    </div>
    <div class="mb-3">
        <strong>Platform:</strong>
        @Model.Platform
    </div>
    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">
        <button type="submit"
                class="btn btn-danger">
            Delete
        </button>
        <a asp-action="Index"
               class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>