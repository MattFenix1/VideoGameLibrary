@model VideoGameLibrary.Models.Game
@{
    ViewData["Title"] = "Delete Game";
}
<h1>Delete Game</h1>
<div class="alert alert-danger">
    <h4>Are you sure you want to delete this game?</h4>
    <p>
        <strong>@Model.Title</strong>
    </p>
</div>
<div class="card">
    <div class="card-body">
        <p>
            <strong>Genre:</strong>
            @Model.Genre
        </p>
        <p>
            <strong>Developer:</strong>
            @Model.Developer
        </p>
        <p>
            <strong>Platform:</strong>
            @Model.Platform
        </p>
        <form asp-action="Delete" method="post">
            <input type="hidden"
                   asp-for="Id" />
            <button type="submit"
                    class="btn btn-danger">
                Delete
            </button>
            <a asp-action="Index"
                   class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>