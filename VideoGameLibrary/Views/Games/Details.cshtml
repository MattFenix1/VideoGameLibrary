@model VideoGameLibrary.Models.Game
@{
    ViewData["Title"] = "Game Details";
}
<h1>Game Details</h1>
<div class="card">
    <div class="card-body">
        <h2>@Model.Title</h2>
        <hr />
        <p>
            <strong>Genre:</strong>
            @Model.Genre
        </p>
        <p>
            <strong>Developer:</strong>
            @Model.Developer
        </p>
        <p>
            <strong>Platform:</strong>
            @Model.Platform
        </p>
        <p>
            <strong>Release Date:</strong>
            @Model.ReleaseDate.ToShortDateString()
        </p>
        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>
        <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
            Edit
        </a>
        <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-danger">
            Delete
        </a>
        <a asp-action="Index"
               class="btn btn-secondary">
            Back to Library
        </a>
    </div>
</div>